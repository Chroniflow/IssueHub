# Backend local profile
SPRING_PROFILES_ACTIVE=local
DB_URL=jdbc:mysql://127.0.0.1:3306/simp_issue_hub?serverTimezone=UTC&characterEncoding=UTF-8
DB_USERNAME=chroniflow
DB_PASSWORD=change-me
SERVER_PORT=8080
APP_CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Optional trusted reverse-proxy header, e.g. X-Real-IP or X-Forwarded-For
REAL_IP_HEADER=
# Site feature configuration file. Environment variables override this file at startup.
SITE_CONFIG_FILE=./data/site-config.properties
TUI_ENABLED=false
APP_VERSION=0.1.0-SNAPSHOT
SITE_ICON_URL=
SITE_ABOUT_CONTENT=
ATTACHMENT_STORAGE_DIRECTORY=./data/attachments
ATTACHMENT_MAX_BYTES=10485760
ATTACHMENT_MAX_REQUEST_BYTES=11534336
ATTACHMENT_ALLOWED_EXTENSIONS=png,jpg,jpeg,gif,webp,mp4,webm,zip,pdf,txt,log
SA_TOKEN_NAME=satoken
SA_TOKEN_TIMEOUT=2592000
SA_TOKEN_ACTIVE_TIMEOUT=1800
SA_TOKEN_LASTING_COOKIE=true
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_PROTOCOL=smtp
SMTP_AUTH=false
SMTP_STARTTLS=false
SMTP_SSL=false
SMTP_CONNECTION_TIMEOUT_MS=5000
SMTP_TIMEOUT_MS=5000
SMTP_WRITE_TIMEOUT_MS=5000
MAIL_FROM=no-reply@localhost
IMAP_HOST=localhost
IMAP_PORT=143
IMAP_USERNAME=
IMAP_PASSWORD=
IMAP_PROTOCOL=imap
IMAP_SSL=false
IMAP_POLL_INTERVAL_MS=60000

# Frontend development server (copy to Frontend/.env.local when needed)
VITE_API_BASE_URL=http://localhost:8080/api/v1
