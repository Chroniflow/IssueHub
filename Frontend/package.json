{
	"name": "simp-issue-hub-frontend",
	"private": true,
	"version": "0.1.0",
	"packageManager": "pnpm@10.15.1",
	"type": "module",
	"scripts": {
		"dev": "vite",
		"build": "vue-tsc -b && vite build",
		"preview": "vite preview",
		"test": "vitest run",
		"test:e2e": "playwright test",
		"lint": "eslint .",
		"format:check": "eslint . --fix-dry-run >/dev/null"
	},
	"pnpm": {
		"overrides": {
			"source-map-js": "1.2.2"
		}
	},
	"dependencies": {
		"@vueuse/core": "^13.9.0",
		"axios": "^1.20.0",
		"pinia": "^3.0.3",
		"vue": "^3.5.42",
		"vue-router": "^4.5.1",
		"zod": "^4.1.12"
	},
	"devDependencies": {
		"@playwright/test": "^1.55.0",
		"@types/node": "^24.5.2",
		"@vitejs/plugin-vue": "^6.0.1",
		"@vue/tsconfig": "^0.8.1",
		"eslint": "^9.37.0",
		"eslint-plugin-vue": "^10.5.0",
		"typescript": "^5.9.2",
		"vite": "^7.1.7",
		"vitest": "^3.2.4",
		"vue-tsc": "^3.0.8"
	}
}
